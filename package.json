{
	"name": "obd-tools",
	"version": "1.1.0",
	"description": "A collection of tools for working with OBD-II data.",
	"type": "module",
	"private": true,
	"author": "@itsEzz",
	"license": "MIT",
	"homepage": "https://github.com/itsEzz/obd-tools#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsEzz/obd-tools.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/obd-tools/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"tailwindcss",
		"vite",
		"obd",
		"obd-ii",
		"obdeleven",
		"vag",
		"automotive-diagnostics",
		"tools"
	],
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"machine-translate": "pnpm dlx @inlang/cli machine translate --project project.inlang",
		"sc:update": "pnpm dlx shadcn-svelte@latest update"
	},
	"dependencies": {
		"pino": "10.3.1",
		"pino-pretty": "^13.2.0",
		"pino-roll": "^4.0.0"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.2",
		"@internationalized/date": "^3.12.4",
		"@itsezz/try-catch": "^1.5.0",
		"@scalar/sveltekit": "^0.3.31",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.1.0",
		"globals": "^17.13.0",
		"mode-watcher": "^1.1.0",
		"phosphor-svelte": "^3.1.1",
		"runed": "^0.38.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-seo": "^2.0.0",
		"svelte-sonner": "^1.2.2",
		"sveltekit-rate-limiter": "^0.8.0",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"xregexp": "^5.1.3",
		"zod": "^4.6.7",
		"zod-openapi": "^6.0.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
