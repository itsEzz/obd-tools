{
	"name": "obd-tools",
	"version": "0.0.1",
	"description": "A collection of tools for working with OBD-II data.",
	"type": "module",
	"private": true,
	"author": "@itsEzz",
	"license": "MIT",
	"homepage": "https://github.com/itsEzz/obd-tools#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsEzz/obd-tools.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/obd-tools/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"tailwindcss",
		"vite",
		"obd",
		"tools"
	],
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"machine-translate": "inlang machine translate --project project.inlang",
		"sc:update": "pnpm dlx shadcn-svelte@latest update"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@inlang/cli": "^3.1.9",
		"@inlang/paraglide-js": "^2.15.3",
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"bits-ui": "^2.17.3",
		"clsx": "^2.1.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"formsnap": "^2.0.1",
		"globals": "^17.4.0",
		"phosphor-svelte": "^3.1.0",
		"prettier": "^3.8.2",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.3",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.0",
		"sveltekit-rate-limiter": "^0.7.0",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.2",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@itsezz/try-catch": "^1.3.0",
		"@scalar/sveltekit": "^0.2.7",
		"mode-watcher": "^1.1.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0",
		"runed": "^0.37.1",
		"xregexp": "^5.1.2",
		"zod-openapi": "^5.4.6"
	}
}
