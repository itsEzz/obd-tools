{
	"name": "obd-tools",
	"version": "1.0.0",
	"description": "A collection of tools for working with OBD-II data.",
	"type": "module",
	"private": true,
	"author": "@itsEzz",
	"license": "MIT",
	"homepage": "https://github.com/itsEzz/obd-tools#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsEzz/obd-tools.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/obd-tools/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"tailwindcss",
		"vite",
		"obd",
		"obd-ii",
		"obdeleven",
		"vag",
		"automotive-diagnostics",
		"tools"
	],
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"machine-translate": "pnpm dlx @inlang/cli machine translate --project project.inlang",
		"sc:update": "pnpm dlx shadcn-svelte@latest update"
	},
	"dependencies": {
		"pino": "^10.3.1",
		"pino-pretty": "^13.2.0",
		"pino-roll": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@internationalized/date": "^3.12.4",
		"@itsezz/try-catch": "^1.5.0",
		"@scalar/sveltekit": "^0.3.30",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.1.0",
		"globals": "^17.13.0",
		"mode-watcher": "^1.1.0",
		"phosphor-svelte": "^3.1.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-seo": "^2.0.0",
		"svelte-sonner": "^1.2.1",
		"sveltekit-rate-limiter": "^0.7.0",
		"sveltekit-superforms": "^2.31.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.4",
		"xregexp": "^5.1.3",
		"zod": "^4.6.7",
		"zod-openapi": "^6.0.2"
	}
}
